# Copy to .env and edit. `python -m drbench.eval` loads .env automatically.
#
# Fill in blocks 1-3 (the judge key is needed for Acc). Everything after them has a working default.

# ============================================================ 1. YOUR MODEL
# Any endpoint that speaks the OpenAI chat-completions API. These three lines are
# the whole "swap in your own model" surface.
MODEL_NAME=gpt-4o
MODEL_BASE_URL=https://api.openai.com/v1
MODEL_API_KEY=

# A local vLLM / sglang server instead:
#   MODEL_NAME=Qwen/Qwen3.6-27B
#   MODEL_BASE_URL=http://localhost:8000/v1
#   MODEL_API_KEY=EMPTY

# ============================================================ 2. RETRIEVAL
# Where the search endpoint listens -- see "3. Retrieval" in README.md. For the Page config you can
# use our hosted endpoint instead: https://drpixel--drpixel-search-gate.us-east.modal.run
SEARCH_URL=http://localhost:19001

# ============================================================ 3. GRADING
# The judge itself is fixed (gpt-5.4-mini, 3 votes) so that scores are comparable; only
# the key and endpoint are yours. OPENAI_API_KEY is used if JUDGE_API_KEY is unset.
JUDGE_API_KEY=
JUDGE_BASE_URL=https://api.openai.com/v1

# ============================================================ 4. TUNING (optional)
# Parallel questions. Raise it for a hosted API; a single local GPU server saturates
# around 12 and the search endpoint serializes retrieval anyway.
CONCURRENCY=4

# Your model's context window. Too low only costs you dropped page images; too high
# gets the request rejected mid-episode. 131072 suits the open models in the paper.
CTX_LIMIT=131072

# Output tokens per turn (every reported run used 8000), escalated on retry.
MODEL_MAX_TOKENS=8000
MODEL_TEMPERATURE=0
MODEL_TIMEOUT=240

# Optional sampling knobs -- sent only if you set them. Default is greedy. The reference run
# is an open model served with its model card's settings, so reproducing THAT number needs:
#   MODEL_TEMPERATURE=0.6  MODEL_TOP_P=0.95  MODEL_TOP_K=20  MODEL_PRESENCE_PENALTY=1.0
# MODEL_TOP_P=
# MODEL_TOP_K=
# MODEL_PRESENCE_PENALTY=
